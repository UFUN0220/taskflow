# Copy to .env for local Docker Compose use. Never commit the copied file.
MYSQL_ROOT_PASSWORD=taskflow_root_local
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=taskflow_local
RABBITMQ_DEFAULT_USER=taskflow
RABBITMQ_DEFAULT_PASS=taskflow_local
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local
ATTACHMENT_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_local
MINIO_BUCKET=taskflow-attachments
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
REDIS_URL=redis://localhost:6380
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=taskflow
RABBITMQ_PASSWORD=taskflow_local
REMINDER_ENABLED=false
