# Copy to .env for local Docker Compose use. Never commit the copied file.
MYSQL_ROOT_PASSWORD=taskflow_root_local
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=taskflow_local
MYSQL_PORT=3307
RABBITMQ_DEFAULT_USER=taskflow
RABBITMQ_DEFAULT_PASS=taskflow_local
RABBITMQ_PORT_HOST=5673
RABBITMQ_MANAGEMENT_PORT=15673
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8080
FRONTEND_PORT=5173
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local
MINIO_BUCKET=taskflow-attachments
FLYWAY_ENABLED=true
TASKFLOW_JWT_SECRET=taskflow-compose-development-secret-change-me-32
TASKFLOW_BOOTSTRAP_ADMIN_ENABLED=true
TASKFLOW_BOOTSTRAP_ADMIN_USERNAME=admin
TASKFLOW_BOOTSTRAP_ADMIN_EMPLOYEE_NO=ADMIN001
TASKFLOW_BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
TASKFLOW_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
AUDIT_ENABLED=true
ATTACHMENT_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_local
MINIO_BUCKET=taskflow-attachments
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
REDIS_URL=redis://localhost:6380
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=taskflow
RABBITMQ_PASSWORD=taskflow_local
REMINDER_ENABLED=true
WEBSOCKET_ENABLED=true
WEBSOCKET_ENDPOINT=/ws/notifications
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
