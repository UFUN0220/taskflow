# Copy to .env for local Docker Compose use, then fill every required secret.
# Never commit the copied file. Empty secret values intentionally make Compose fail fast.
SPRING_PROFILES_ACTIVE=dev
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=
MYSQL_PORT=3307
RABBITMQ_DEFAULT_USER=taskflow
RABBITMQ_DEFAULT_PASS=
RABBITMQ_PORT_HOST=5673
RABBITMQ_MANAGEMENT_PORT=15673
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8080
FRONTEND_PORT=5173
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=taskflow-attachments
FLYWAY_ENABLED=true
# Required: generate a unique local-only value of at least 32 characters.
TASKFLOW_JWT_SECRET=
TASKFLOW_AUTH_LOGIN_RATE_LIMIT_ENABLED=true
TASKFLOW_AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
TASKFLOW_AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
TASKFLOW_BOOTSTRAP_ADMIN_ENABLED=true
TASKFLOW_BOOTSTRAP_ADMIN_USERNAME=admin
TASKFLOW_BOOTSTRAP_ADMIN_EMPLOYEE_NO=ADMIN001
TASKFLOW_BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
# Required only when bootstrap admin is enabled; use a unique local-only value.
TASKFLOW_BOOTSTRAP_ADMIN_PASSWORD=
AUDIT_ENABLED=true
ATTACHMENT_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=taskflow-attachments
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
REDIS_URL=redis://localhost:6380
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=taskflow
RABBITMQ_PASSWORD=
REMINDER_ENABLED=true
WEBSOCKET_ENABLED=true
WEBSOCKET_ENDPOINT=/ws/notifications
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Isolated acceptance environment only. Keep every value empty in this file;
# inject credentials from the process/CI secret store.
TASKFLOW_ACCEPTANCE_DB_ROOT_PASSWORD=
TASKFLOW_ACCEPTANCE_DB_NAME=
TASKFLOW_ACCEPTANCE_DB_USERNAME=
TASKFLOW_ACCEPTANCE_DB_PASSWORD=
TASKFLOW_ACCEPTANCE_RABBITMQ_USERNAME=
TASKFLOW_ACCEPTANCE_RABBITMQ_PASSWORD=
TASKFLOW_ACCEPTANCE_MINIO_ROOT_USER=
TASKFLOW_ACCEPTANCE_MINIO_ROOT_PASSWORD=
TASKFLOW_ACCEPTANCE_JWT_SECRET=
TASKFLOW_ACCEPTANCE_ADMIN_USERNAME=
TASKFLOW_ACCEPTANCE_ADMIN_PASSWORD=
TASKFLOW_ACCEPTANCE_TEST_USER_PASSWORD=
