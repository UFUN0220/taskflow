spring:
  datasource:
    url: jdbc:mysql://localhost:3307/taskflow?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: taskflow
    password: change-me-in-local-config
  flyway:
    enabled: true
    locations: classpath:db/migration
  data:
    redis:
      url: redis://localhost:6380
  rabbitmq:
    host: localhost
    port: 5673
    username: taskflow
    password: taskflow_local

taskflow:
  audit:
    enabled: true
  websocket:
    enabled: true
    endpoint: /ws/notifications
    allowed-origins:
      - http://localhost:5173
      - http://127.0.0.1:5173
  infrastructure:
    redis-url: redis://localhost:6380
    rabbitmq-host: localhost
    rabbitmq-port: 5673
    minio-endpoint: http://localhost:9000
  reminder:
    enabled: true
    due-soon-lead-time: 24h
    scan-batch-size: 100
    scan-delay-ms: 10000
    rebuild-delay-ms: 300000
    lock-ttl: 30s
    redis-key: taskflow:reminders:due
    lock-key: taskflow:reminders:scan-lock
    rabbit:
      exchange: taskflow.reminder
      queue: taskflow.reminder.dispatch
      routing-key: reminder.due
      task-status-routing-key: task.status.changed
      retry-exchange: taskflow.reminder.retry
      retry-queue: taskflow.reminder.retry
      retry-routing-key: reminder.retry
      dead-letter-exchange: taskflow.reminder.dlx
      dead-letter-queue: taskflow.reminder.dead
      dead-letter-routing-key: reminder.dead
      max-attempts: 3
      retry-delay-ms: 5000
  attachment:
    enabled: true
    minio:
      endpoint: http://localhost:9000
      access-key: minioadmin
      secret-key: minioadmin_local
      bucket: taskflow-attachments
    max-file-size-bytes: 10485760
    presigned-expiry-seconds: 600
